<Project>

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <!-- Sandy Soil local builds (official CI stamps this via GitVersion). Bump sandy.N per build.
         "+sandy.N" is build metadata, so the updater still sees 6.8.6 and won't offer a "newer" 6.8.6. -->
    <Version>6.8.6</Version>
    <InformationalVersion>6.8.6+sandy.5</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>